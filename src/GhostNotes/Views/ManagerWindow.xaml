<Window x:Class="GhostNotes.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GhostNotes Manager"
        Width="960" Height="640"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, -apple-system, system-ui, sans-serif">

    <Window.Resources>
        <!-- Toolbar button style -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0" Margin="2,0">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <Ellipse x:Name="dot" Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Card style -->
        <Style x:Key="NoteCardBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="38"/>
            <!-- Tab Strip -->
            <RowDefinition Height="40"/>
            <!-- Main Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOP TITLE BAR ════════════════════ -->
        <Grid Grid.Row="0" Background="#0B1120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand / Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource IconShield}" Width="16" Height="16" 
                      Stroke="#38BDF8" StrokeThickness="1.5" Fill="#0284C7" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="GhostNotes" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                <TextBlock Text=" v2" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="4,1,0,0"/>
            </StackPanel>

            <!-- OBS Capture Status Pill -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#162E25" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="10,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShield}" Width="11" Height="11" 
                          Stroke="#10B981" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="OBS &amp; Screen Share Protected" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource ToolBtn}" Click="OnDeployTabClicked" Height="26" Padding="10,2" Margin="0,0,8,0"
                        Background="#0369A1" BorderBrush="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEye}" Width="12" Height="12" Stroke="#FFFFFF" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Deploy to Desktop"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="OnHideToTrayClicked" Height="26" Width="26" ToolTip="Hide to System Tray">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="#94A3B8" StrokeThickness="1.6" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════════ TAB STRIP ════════════════════ -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,1">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0,60,0">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <!-- Dynamic Tab Buttons populated here -->
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Add Tab Button -->
                <Button Style="{StaticResource ToolBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Width="28" Height="28" Click="OnAddTabClicked" ToolTip="Create new Tab">
                    <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="1.8" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════ MAIN CONTENT ════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Note Sidebar -->
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320"/>
                <!-- Center Editor / Preview -->
                <ColumnDefinition Width="*"/>
                <!-- Settings Panel -->
                <ColumnDefinition Width="190" MinWidth="160" MaxWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: NOTE SIDEBAR ── -->
            <Border Grid.Column="0" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <Button Style="{StaticResource ToolBtn}" HorizontalAlignment="Right" Width="24" Height="24"
                                Click="OnAddNoteClicked" ToolTip="New Note in this Tab">
                            <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stroke="#38BDF8" StrokeThickness="1.8" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Note List Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NotesListPanel" Margin="8,2,8,8">
                            <!-- Populated with note cards -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── CENTER: MARKDOWN EDITOR & PREVIEW ── -->
            <Border Grid.Column="1" Background="#0F172A">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Formatting Toolbar -->
                        <RowDefinition Height="40"/>
                        <!-- Editor / Preview Area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Markdown Command Toolbar with Coolicons -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="6,0">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                            <!-- Text styling -->
                            <Button Style="{StaticResource ToolBtn}" Click="OnBoldClicked" ToolTip="Bold (**text**)" Width="28">
                                <Path Data="{StaticResource IconBold}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.6" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnItalicClicked" ToolTip="Italic (*text*)" Width="28">
                                <Path Data="{StaticResource IconItalic}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.6" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnStrikethroughClicked" ToolTip="Strikethrough (~~text~~)" Width="28">
                                <Path Data="{StaticResource IconStrikethrough}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.6" Stretch="Uniform"/>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="#475569" Margin="4,0"/>

                            <!-- Headings -->
                            <Button Style="{StaticResource ToolBtn}" Click="OnH1Clicked" ToolTip="Heading 1 (#)" Width="28">
                                <TextBlock Text="H1" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnH2Clicked" ToolTip="Heading 2 (##)" Width="28">
                                <TextBlock Text="H2" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnH3Clicked" ToolTip="Heading 3 (###)" Width="28">
                                <TextBlock Text="H3" FontSize="11" FontWeight="Bold"/>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="#475569" Margin="4,0"/>

                            <!-- Lists & Tasks -->
                            <Button Style="{StaticResource ToolBtn}" Click="OnBulletListClicked" ToolTip="Bullet List (- )" Width="28">
                                <Path Data="{StaticResource IconList}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnNumberedListClicked" ToolTip="Numbered List (1. )" Width="28">
                                <Path Data="{StaticResource IconListOl}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnTaskCheckboxClicked" ToolTip="Task Checkbox (- [ ])" Width="28">
                                <Path Data="{StaticResource IconCheckSquare}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="#475569" Margin="4,0"/>

                            <!-- Code, Quote, Link -->
                            <Button Style="{StaticResource ToolBtn}" Click="OnCodeClicked" ToolTip="Code (`code`)" Width="28">
                                <Path Data="{StaticResource IconCode}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnQuoteClicked" ToolTip="Blockquote (&gt; )" Width="28">
                                <Path Data="{StaticResource IconQuote}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnLinkClicked" ToolTip="Hyperlink ([text](url))" Width="28">
                                <Path Data="{StaticResource IconLink}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Click="OnHrClicked" ToolTip="Horizontal Rule (---)" Width="28">
                                <Path Data="{StaticResource IconMinus}" Width="12" Height="12" Stroke="#CBD5E1" StrokeThickness="2" Stretch="Uniform"/>
                            </Button>

                            <!-- Preview Toggle Button -->
                            <Button x:Name="BtnTogglePreview" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}"
                                    Click="OnTogglePreviewClicked" ToolTip="Toggle Markdown Preview (Ctrl+P)" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="IconPreview" Data="{StaticResource IconEye}" Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtPreview" Text="Preview (Ctrl+P)" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Editor and Live Preview Panels -->
                    <Grid Grid.Row="1">
                        <!-- Monospace Markdown Editor -->
                        <TextBox x:Name="EditorBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 Background="#0F172A"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#38BDF8"
                                 FontFamily="JetBrains Mono, Consolas, Courier New, monospace"
                                 FontSize="13.5"
                                 Padding="16"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnEditorTextChanged"/>

                        <!-- Live Rendered Markdown Preview -->
                        <Border x:Name="PreviewPanel" Background="#0F172A" Visibility="Collapsed">
                            <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                      Background="#0F172A"
                                                      Foreground="#F8FAFC"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── RIGHT: NOTE SETTINGS PANEL ── -->
            <Border Grid.Column="2" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="1,0,0,0" Padding="14,12">
                <StackPanel>
                    <!-- Settings Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconSettings}" Width="13" Height="13" Stroke="#64748B" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="NOTE SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Tint Swatches -->
                    <TextBlock Text="Overlay Color Tint" FontSize="12" FontWeight="Medium" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="TintPanel" Margin="0,0,0,16">
                        <Border Width="24" Height="24" Background="#FFF59D" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="#38BDF8" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#FFF59D" ToolTip="Yellow"/>
                        <Border Width="24" Height="24" Background="#BBDEFB" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#BBDEFB" ToolTip="Blue"/>
                        <Border Width="24" Height="24" Background="#C8E6C9" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#C8E6C9" ToolTip="Green"/>
                        <Border Width="24" Height="24" Background="#F8BBD0" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#F8BBD0" ToolTip="Pink"/>
                        <Border Width="24" Height="24" Background="#D1C4E9" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#D1C4E9" ToolTip="Purple"/>
                        <Border Width="24" Height="24" Background="#FFFFFF" CornerRadius="5" Margin="0,0,6,6" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#FFFFFF" ToolTip="White"/>
                    </WrapPanel>

                    <!-- Opacity Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Overlay Opacity" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtOpacityVal" Text="85%" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SliderOpacity" Minimum="0.3" Maximum="1.0" Value="0.85" SmallChange="0.05" LargeChange="0.1"
                            ValueChanged="OnOpacityValueChanged" Margin="0,0,0,16"/>

                    <!-- Font Size Zoom -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Font Size" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtFontSizeVal" Text="14pt" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SliderFontSize" Minimum="10" Maximum="26" Value="14" IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="OnFontSizeValueChanged" Margin="0,0,0,24"/>

                    <!-- Delete Note Button -->
                    <Button Style="{StaticResource ToolBtn}" Click="OnDeleteNoteClicked" Background="#450A0A" BorderBrush="#991B1B" Foreground="#F87171"
                            Height="32" Padding="12,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Stroke="#F87171" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete Note" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
