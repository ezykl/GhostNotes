<Window x:Class="GhostNotes.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MinWidth="140"
        MinHeight="34"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        Title="GhostNote">

    <Window.Resources>
        <!-- Transparent Grip style for 8-way resize -->
        <Style x:Key="Grip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header button style -->
        <Style x:Key="HdrBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Modern Scrollbar Style -->
        <Style x:Key="MinimalScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#40808080" CornerRadius="3" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#70808080"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#99808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MinimalScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main Note Glass Container -->
        <Border x:Name="Glass" CornerRadius="12" BorderBrush="#60FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.30"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header / Drag Strip -->
                    <RowDefinition Height="32"/>
                    <!-- Content Body -->
                    <RowDefinition Height="*" x:Name="BodyRow"/>
                </Grid.RowDefinitions>

                <!-- ════════════ HEADER BAR ════════════ -->
                <Border Grid.Row="0" x:Name="HeaderBorder" Background="#20000000" CornerRadius="11,11,0,0"
                        Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseDown"
                        PreviewMouseMove="OnHeaderMouseMove" MouseLeftButtonUp="OnHeaderMouseUp">
                    <Grid Margin="6,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ghost Logo (From GhostNotes.svg with dynamic accent) -->
                        <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,6,0">
                            <Canvas Width="26" Height="26">
                                <!-- Ghost Body Fill -->
                                <Path x:Name="GhostBody"
                                      Data="M8.14779 8.97833C8.14779 5.91296 10.6328 3.42798 13.6981 3.42798C16.7635 3.42798 19.2485 5.91296 19.2485 8.97834V11.9777C19.2485 16.7242 15.4007 20.572 10.6542 20.572H4.7511C6.81602 19.6584 8.14779 17.6129 8.14779 15.3549V8.97833Z"
                                      Fill="#FFFFFF" Opacity="0.88"/>
                                <!-- Ghost Outer Stroke & Dynamic Accent Glow -->
                                <Path x:Name="GhostStroke"
                                      Data="M19.2487 11.9775V8.97851C19.2487 6.009 16.9168 3.58415 13.9843 3.43537L13.6987 3.4279C10.6334 3.4279 8.14812 5.91313 8.14812 8.97851V15.3545L8.14404 15.566C8.06394 17.7396 6.75176 19.687 4.7514 20.572H10.6542L10.8765 20.5693C15.5204 20.4515 19.2487 16.6498 19.2487 11.9775ZM19.9449 11.9775C19.9449 17.1085 15.7852 21.2682 10.6542 21.2682H4.7514C4.42246 21.2682 4.13827 21.0379 4.07015 20.7161C4.00212 20.3942 4.16903 20.068 4.46992 19.9349C6.28268 19.1328 7.45192 17.3368 7.45192 15.3545V8.97851C7.45192 5.52863 10.2489 2.73169 13.6987 2.73169C17.1485 2.73184 19.9449 5.52872 19.9449 8.97851V11.9775Z"
                                      Fill="#38BDF8">
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="GhostGlow" BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.8"/>
                                    </Path.Effect>
                                </Path>
                                <!-- Eyes -->
                                <Path Data="M13.1163 7.70898C13.7329 7.70898 14.2334 8.35251 14.2335 9.14648C14.2335 9.94065 13.733 10.585 13.1163 10.585C12.4998 10.5847 12.0001 9.9405 12.0001 9.14648C12.0003 8.35265 12.4999 7.70922 13.1163 7.70898ZM16.6613 7.70898C17.2778 7.70898 17.7783 8.35249 17.7784 9.14648C17.7784 9.94065 17.2779 10.585 16.6613 10.585C16.0447 10.5847 15.545 9.94051 15.545 9.14648C15.5452 8.35263 16.0448 7.7092 16.6613 7.70898Z"
                                      Fill="#0F172A" Opacity="0.8"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Note Title -->
                        <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="GhostNote" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#99000000" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,4,0"/>

                        <!-- Header Action Buttons -->
                        <StackPanel x:Name="HeaderButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Note Button (+) -->
                            <Button Style="{StaticResource HdrBtn}" Click="OnNewNoteClicked" ToolTip="New Note (Ctrl+Alt+N)">
                                <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stroke="#77000000" StrokeThickness="1.8" Stretch="Uniform"/>
                            </Button>
                            <!-- Settings Gear Button -->
                            <Button x:Name="BtnSettings" Style="{StaticResource HdrBtn}" Click="OnSettingsClicked" ToolTip="Note Settings (Color, Opacity, Font)">
                                <Path Data="{StaticResource IconSettings}" Width="11" Height="11" Stroke="#77000000" StrokeThickness="1.5" Stretch="Uniform"/>
                            </Button>
                            <!-- Minimize Button (—) to Ghost Pill -->
                            <Button Style="{StaticResource HdrBtn}" Click="OnMinimizeClicked" ToolTip="Minimize to Edge Pill">
                                <Path Data="{StaticResource IconMinus}" Width="10" Height="10" Stroke="#77000000" StrokeThickness="2" Stretch="Uniform"/>
                            </Button>
                            <!-- Close / Hide Button (✕) -->
                            <Button Style="{StaticResource HdrBtn}" Click="OnCloseClicked" ToolTip="Close / Hide Note (Reopen from tray)">
                                <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="#77000000" StrokeThickness="1.6" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Minimized Pill Controls (shown only when collapsed) -->
                        <StackPanel x:Name="PillControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="PillHint" Text="Click to open" FontSize="10" FontStyle="Italic"
                                       Foreground="#88000000" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonUp="OnRestorePillClicked"/>
                            <Button Style="{StaticResource HdrBtn}" Click="OnRestorePillClicked" ToolTip="Expand Note">
                                <Path Data="{StaticResource IconExpand}" Width="9" Height="9" Stroke="#77000000" StrokeThickness="1.6" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════ DIRECT IN-PLACE EDITOR ════════════ -->
                <Grid Grid.Row="1" x:Name="BodyContainer">
                    <RichTextBox x:Name="EditorBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,6,10,24"
                                 Foreground="#DD000000"
                                 FontFamily="Segoe UI, -apple-system, system-ui, sans-serif"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="OnEditorTextChanged"/>

                    <!-- Bottom Hover Toolbar Trigger Area & Floating Capsule -->
                    <Border x:Name="BottomHoverArea" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="36"
                            Background="Transparent" MouseEnter="OnBottomAreaMouseEnter" MouseLeave="OnBottomAreaMouseLeave">
                        <Border x:Name="HoverToolbar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                Background="#E81E293B" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="12"
                                Padding="5,2" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <!-- Bold -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarBold" ToolTip="Bold (Ctrl+B)" Margin="1,0">
                                    <Path Data="{StaticResource IconBold}" Width="9" Height="9" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <!-- Italic -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarItalic" ToolTip="Italic (Ctrl+I)" Margin="1,0">
                                    <Path Data="{StaticResource IconItalic}" Width="9" Height="9" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <!-- Underline -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarUnderline" ToolTip="Underline (Ctrl+U)" Margin="1,0">
                                    <TextBlock Text="U" FontWeight="Bold" FontSize="10.5" TextDecorations="Underline" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                </Button>
                                <!-- Strikethrough -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarStrikethrough" ToolTip="Strikethrough" Margin="1,0">
                                    <Path Data="{StaticResource IconStrikethrough}" Width="9" Height="9" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <Rectangle Width="1" Height="12" Fill="#475569" Margin="3,0"/>
                                <!-- Bullet List -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarBullets" ToolTip="Bullet List" Margin="1,0">
                                    <Path Data="{StaticResource IconList}" Width="10" Height="10" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <!-- Numbered List -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarNumbers" ToolTip="Numbered List" Margin="1,0">
                                    <Path Data="{StaticResource IconListOl}" Width="10" Height="10" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <!-- Task Checkbox -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarTask" ToolTip="Checkbox Task [ ]" Margin="1,0">
                                    <Path Data="{StaticResource IconCheckSquare}" Width="9" Height="9" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                                <!-- Code -->
                                <Button Style="{StaticResource HdrBtn}" Width="22" Height="22" Click="OnToolbarCode" ToolTip="Inline Code (`code`)" Margin="1,0">
                                    <Path Data="{StaticResource IconCode}" Width="10" Height="10" Stroke="#E2E8F0" StrokeThickness="1.6" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ════════════ IN-PLACE SETTINGS FLYOUT (Solid Overlay) ════════════ -->
        <Border x:Name="SettingsFlyout" VerticalAlignment="Top" HorizontalAlignment="Right"
                Background="#FF1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8"
                Padding="12,10" Margin="0,34,8,8" Width="186" MaxHeight="320" Panel.ZIndex="100" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">
                    <!-- Flyout Title -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Note Settings" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Button HorizontalAlignment="Right" Width="18" Height="18" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="OnCloseSettingsClicked">
                            <Path Data="{StaticResource IconClose}" Width="8" Height="8" Stroke="#94A3B8" StrokeThickness="1.6" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Color Tint Swatches -->
                    <TextBlock Text="Color Tint" FontSize="10.5" FontWeight="Medium" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="TintWrapPanel" Margin="0,0,0,8">
                        <Border Width="20" Height="20" Background="#FFF59D" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="#38BDF8" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#FFF59D" ToolTip="Yellow"/>
                        <Border Width="20" Height="20" Background="#BBDEFB" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#BBDEFB" ToolTip="Sky Blue"/>
                        <Border Width="20" Height="20" Background="#C8E6C9" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#C8E6C9" ToolTip="Mint Green"/>
                        <Border Width="20" Height="20" Background="#F8BBD0" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#F8BBD0" ToolTip="Pastel Pink"/>
                        <Border Width="20" Height="20" Background="#D1C4E9" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#D1C4E9" ToolTip="Lavender"/>
                        <Border Width="20" Height="20" Background="#FFFFFF" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectTint" Tag="#FFFFFF" ToolTip="White"/>
                    </WrapPanel>

                    <!-- Font Color Swatches -->
                    <TextBlock Text="Font Color" FontSize="10.5" FontWeight="Medium" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="FontColorWrapPanel" Margin="0,0,0,10">
                        <Border Width="20" Height="20" Background="#1E293B" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="#38BDF8" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#1E293B" ToolTip="Black / Charcoal"/>
                        <Border Width="20" Height="20" Background="#FFFFFF" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#FFFFFF" ToolTip="White"/>
                        <Border Width="20" Height="20" Background="#DC2626" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#DC2626" ToolTip="Crimson Red"/>
                        <Border Width="20" Height="20" Background="#0284C7" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#0284C7" ToolTip="Ocean Blue"/>
                        <Border Width="20" Height="20" Background="#059669" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#059669" ToolTip="Emerald Green"/>
                        <Border Width="20" Height="20" Background="#7C3AED" CornerRadius="4" Margin="0,0,5,5" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2" MouseLeftButtonDown="OnSelectFontColor" Tag="#7C3AED" ToolTip="Royal Purple"/>
                    </WrapPanel>

                    <!-- Note Opacity Slider -->
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Note Opacity" FontSize="10.5" FontWeight="Medium" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtOpacityVal" Text="85%" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SliderOpacity" Minimum="0.2" Maximum="1.0" Value="0.85" SmallChange="0.05" LargeChange="0.1"
                            ValueChanged="OnOpacityValueChanged" Margin="0,0,0,10"/>

                    <!-- Font Size -->
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Font Size" FontSize="10.5" FontWeight="Medium" Foreground="#94A3B8"/>
                        <TextBlock x:Name="TxtFontSizeVal" Text="14pt" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SliderFontSize" Minimum="10" Maximum="24" Value="14" IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="OnFontSizeValueChanged" Margin="0,0,0,12"/>

                    <!-- Permanent Delete Button -->
                    <Button Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#FCA5A5"
                            Height="26" Padding="8,0" Cursor="Hand" Click="OnPermanentDeleteClicked" ToolTip="Permanently remove note from disk">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconTrash}" Width="10" Height="10" Stroke="#FCA5A5" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Delete Permanently" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ════════════ 8-DIRECTION RESIZE GRIPS ════════════ -->
        <Grid x:Name="ResizeGrips">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8"/>
                <RowDefinition/>
                <RowDefinition Height="8"/>
            </Grid.RowDefinitions>
            <Thumb Grid.Row="0" Grid.Column="0" Style="{StaticResource Grip}" Cursor="SizeNWSE" Tag="NW" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="0" Grid.Column="1" Style="{StaticResource Grip}" Cursor="SizeNS" Tag="N" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="0" Grid.Column="2" Style="{StaticResource Grip}" Cursor="SizeNESW" Tag="NE" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="1" Grid.Column="0" Style="{StaticResource Grip}" Cursor="SizeWE" Tag="W" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="1" Grid.Column="2" Style="{StaticResource Grip}" Cursor="SizeWE" Tag="E" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="2" Grid.Column="0" Style="{StaticResource Grip}" Cursor="SizeNESW" Tag="SW" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="2" Grid.Column="1" Style="{StaticResource Grip}" Cursor="SizeNS" Tag="S" DragDelta="OnResizeDelta"/>
            <Thumb Grid.Row="2" Grid.Column="2" Style="{StaticResource Grip}" Cursor="SizeNWSE" Tag="SE" DragDelta="OnResizeDelta"/>
        </Grid>
    </Grid>
</Window>
